---
const { degree, institution, dates, description } = Astro.props;
---

<div class="bg-white rounded-lg p-5 mb-4 border border-gray-200 hover:shadow-md transition">
  <div class="flex flex-wrap justify-between items-baseline gap-2 mb-1">
    <h3 class="font-semibold text-lg text-gray-900">{degree}</h3>
    <span class="text-sm text-gray-500">{dates}</span>
  </div>
  <p class="text-pink-600 font-medium mb-2">{institution}</p>
  <p class="text-gray-700 text-sm">{description}</p>
</div>