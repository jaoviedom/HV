---
const { role, company, dates, description, technologies = [] } = Astro.props;
---

<div class="bg-white rounded-lg p-5 mb-4 border border-gray-200 hover:shadow-md transition">
  <div class="flex flex-wrap justify-between items-baseline gap-2 mb-1">
    <h3 class="font-semibold text-lg text-gray-900">{role}</h3>
    <span class="text-sm text-gray-500">{dates}</span>
  </div>
  <p class="text-blue-600 font-medium mb-2">{company}</p>
  <p class="text-gray-700 text-sm mb-3">{description}</p>
  {technologies.length > 0 && (
    <div class="flex flex-wrap gap-2">
      {technologies.map((tech: any) => (
        <span class="bg-blue-100 text-blue-800 text-xs px-2.5 py-1 rounded-full">
          {tech}
        </span>
      ))}
    </div>
  )}
</div>