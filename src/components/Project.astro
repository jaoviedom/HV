---
const { name, description, link } = Astro.props;
---

<div class="bg-white rounded-lg p-5 border border-gray-200 hover:shadow-lg transition transform hover:-translate-y-1">
  <h3 class="font-semibold text-lg text-gray-900 mb-2">{name}</h3>
  <p class="text-gray-700 text-sm mb-3">{description}</p>
  <a href={link} target="_blank" class="text-blue-600 hover:text-blue-800 text-sm font-medium inline-flex items-center gap-1">
    Ver repositorio →
  </a>
</div>